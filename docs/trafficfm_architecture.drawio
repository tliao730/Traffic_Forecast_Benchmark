        <!-- Checkpoint -->
        <mxCell id="ckpt_box" value="&lt;b&gt;Checkpoint&lt;/b&gt;&#xa;benchmark/experiments/&#xa;────────────────────&#xa;mamba_fm/SD/2018/&#xa;  best_model_short_s2023.pt&#xa;  best_model_medium_s2023.pt&#xa;  best_model_long_s2023.pt&#xa;&#xa;gnn/experiments/GWNET/SD/&#xa;  best_model.pth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;fontColor=#333333;" vertex="1" parent="1">
