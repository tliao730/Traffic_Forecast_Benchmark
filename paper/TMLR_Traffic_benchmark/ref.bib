@article{SHAO2025105152,
title = {Cross-City traffic prediction based on deep domain adaptive transfer learning},
journal = {Transportation Research Part C: Emerging Technologies},
volume = {176},
pages = {105152},
year = {2025},
issn = {0968-090X},
doi = {https://doi.org/10.1016/j.trc.2025.105152},
url = {https://www.sciencedirect.com/science/article/pii/S0968090X25001561},
author = {Junqi Shao and Shen Li and Ke Zhang and Anyou Wang and Meng Li},
keywords = {Traffic Prediction, Transfer Learning, Data Enhancement, Uncertainty Quantification},
abstract = {Traffic prediction is essential for urban traffic management. In practice, sensor malfunctions or transmission errors often lead to incomplete traffic data, which in turn makes data missing a common and challenging issue. This frequently has a significant impact on the accuracy of prediction models. Traditional methods—such as interpolation, statistical techniques, and data-driven approaches like deep learning—struggle under severe data loss conditions. Traditional machine learning methods typically rely on the same data source for predictions, thus the performance can degrade significantly with high missing rate. In such cases, transferring effective information from multi-sources data to enhance performance on the target domain data has emerged as an effective strategy to address this issue. To address these issues, this study introduces a knowledge distillation-based adversarial domain adaptive transfer learning framework that utilizes knowledge from related domains to compensate for data deficiencies in the target domain. This framework integrates multi-source data and enhances prediction accuracy through cross-domain knowledge transfer. We propose an innovative model, the Missing Data Transfer Learning Graph Convolutional Network (MDTLGCN). This model combines graph convolutional neural networks with knowledge distillation-based transfer learning techniques, enabling high-precision predictions with spatiotemporal data missing. We conduct experiments on two real-world datasets to verify the effectiveness of our MDTLGCN model by comparing it with several state-of-the-art baselines. By utilizing knowledge distillation, the model effectively transfers knowledge from related domains, while adversarial domain adaptation ensures robust cross-domain alignment, even under severe data loss conditions. These techniques not only compensate for data deficiencies but also enhance the accuracy and adaptability of traffic prediction systems by fully integrating multi-source data.}
}

